# Install as /etc/novel/novel.env with owner root:novel and mode 0640.
NOVEL_DB_URL=jdbc:mysql://127.0.0.1:3306/novel?characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
NOVEL_DB_USERNAME=novel_app
NOVEL_DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
NOVEL_REDIS_HOST=127.0.0.1
NOVEL_REDIS_PORT=6379
NOVEL_REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
NOVEL_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
NOVEL_ADMIN_JWT_SECRET=REPLACE_WITH_A_DIFFERENT_32_BYTE_SECRET
NOVEL_ADMIN_BOOTSTRAP_USERNAME=REPLACE_WITH_ADMIN_USERNAME
NOVEL_ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
NOVEL_OSS_ENDPOINT=https://oss-cn-hongkong.aliyuncs.com
NOVEL_OSS_BUCKET=REPLACE_WITH_PRIVATE_BUCKET_NAME
NOVEL_OSS_ACCESS_KEY_ID=REPLACE_WITH_RAM_ACCESS_KEY_ID
NOVEL_OSS_ACCESS_KEY_SECRET=REPLACE_WITH_RAM_ACCESS_KEY_SECRET
NOVEL_OSS_PUBLIC_BASE_URL=https://REPLACE_WITH_BUCKET_NAME.oss-cn-hongkong.aliyuncs.com
