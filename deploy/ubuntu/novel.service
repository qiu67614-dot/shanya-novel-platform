[Unit]
Description=Novel Spring Boot service
After=network-online.target mysql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=novel
Group=novel
WorkingDirectory=/opt/novel
EnvironmentFile=/etc/novel/novel.env
ExecStart=/usr/bin/java -Xms256m -Xmx1536m -jar /opt/novel/novel-service.jar --spring.profiles.active=prod
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
