# 统一换行符，避免 Windows 开发 + Linux 部署时的 CRLF 问题
* text=auto

# 部署脚本必须是 LF，否则 Ubuntu 上会报 bad interpreter: /usr/bin/env bash^M
*.sh text eol=lf

# 数据库脚本与配置文件统一 LF
*.sql text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# systemd 单元与 MySQL 配置：CRLF 会让 unit 解析失败（ExecStart 末尾带 \r）
*.service text eol=lf
*.timer text eol=lf
*.cnf text eol=lf
*.env text eol=lf
*.example text eol=lf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.jar binary
*.woff binary
*.woff2 binary
*.ttf binary
