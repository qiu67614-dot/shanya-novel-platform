{
  "openapi": "3.0.3",
  "info": {
    "title": "山崖书院投稿与审核 API",
    "version": "1.0.0",
    "description": "可直接导入 Apifox。所有接口返回 {code,data,message}；业务失败也可能使用 HTTP 200。普通用户与管理员使用不同 JWT，Authorization 直接放 token，不加 Bearer。"
  },
  "servers": [
    { "url": "/api", "description": "前端开发代理" },
    { "url": "http://localhost:8080", "description": "后端直连" }
  ],
  "tags": [
    { "name": "读者投稿" },
    { "name": "管理员认证" },
    { "name": "投稿审核" },
    { "name": "撤回审核" },
    { "name": "公开作品管理" },
    { "name": "审核日志" }
  ],
  "paths": {
    "/front/me/imports": {
      "post": {
        "tags": ["读者投稿"], "summary": "导入私人 TXT 或提交公开投稿", "security": [{ "UserToken": [] }],
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "$ref": "#/components/schemas/ImportForm" } } } },
        "responses": { "200": { "$ref": "#/components/responses/PrivateNovelResult" } }
      }
    },
    "/front/me/imports/{novelId}/resubmit": {
      "post": {
        "tags": ["读者投稿"], "summary": "修改退稿资料并重新提交审核", "description": "仅 REJECTED 或 CANCELLED 且未发布过的投稿可重投。file 可选；提供新 TXT 时重置私人阅读进度。", "security": [{ "UserToken": [] }],
        "parameters": [{ "$ref": "#/components/parameters/NovelId" }],
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "$ref": "#/components/schemas/ResubmitForm" } } } },
        "responses": { "200": { "$ref": "#/components/responses/PrivateNovelResult" } }
      }
    },
    "/front/me/imports/{novelId}/cancel-submission": {
      "post": {
        "tags": ["读者投稿"], "summary": "取消待审核投稿", "security": [{ "UserToken": [] }],
        "parameters": [{ "$ref": "#/components/parameters/NovelId" }],
        "responses": { "200": { "$ref": "#/components/responses/EmptyResult" } }
      }
    },
    "/front/me/publications": {
      "get": {
        "tags": ["读者投稿"], "summary": "查询我的已发布作品", "description": "私人原件删除后，仍返回独立的公开副本；此时 id 为 null。", "security": [{ "UserToken": [] }],
        "responses": { "200": { "description": "成功", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Envelope" }, { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/PrivateNovel" } } } }] } } } } }
      }
    },
    "/front/me/publications/{bookId}/withdrawals": {
      "post": {
        "tags": ["读者投稿"], "summary": "申请撤回公开作品", "description": "审核期间作品仍公开；同一作品只允许一个待处理申请。", "security": [{ "UserToken": [] }],
        "parameters": [{ "$ref": "#/components/parameters/BookId" }],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "reason": { "type": "string", "maxLength": 500 } } } } } },
        "responses": { "200": { "$ref": "#/components/responses/EmptyResult" } }
      }
    },
    "/admin/auth/login": {
      "post": {
        "tags": ["管理员认证"], "summary": "管理员登录", "description": "独立的 admin_user 账号，不接受普通用户 JWT。", 
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["username", "password"], "properties": { "username": { "type": "string" }, "password": { "type": "string", "format": "password" } } } } } },
        "responses": { "200": { "description": "成功", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Envelope" }, { "type": "object", "properties": { "data": { "type": "object", "properties": { "token": { "type": "string" }, "id": { "type": "integer", "format": "int64" }, "username": { "type": "string" } } } } }] } } } } }
      }
    },
    "/admin/submissions": {
      "get": {
        "tags": ["投稿审核"], "summary": "分页查询投稿", "security": [{ "AdminToken": [] }],
        "parameters": [{ "name": "status", "in": "query", "schema": { "type": "string", "enum": ["PENDING", "REJECTED", "APPROVED", "CANCELLED"] } }, { "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/Size" }],
        "responses": { "200": { "$ref": "#/components/responses/SubmissionPage" } }
      }
    },
    "/admin/submissions/{id}": {
      "get": {
        "tags": ["投稿审核"], "summary": "查询投稿详情", "security": [{ "AdminToken": [] }],
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": { "200": { "description": "成功", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Envelope" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Submission" } } }] } } } } }
      }
    },
    "/admin/submissions/{id}/chapters": {
      "get": {
        "tags": ["投稿审核"], "summary": "预览投稿章节目录", "description": "最多返回 5000 章，目录不含正文。", "security": [{ "AdminToken": [] }],
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": { "200": { "description": "成功", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Envelope" }, { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/PreviewChapter" } } } }] } } } } }
      }
    },
    "/admin/submissions/{id}/chapters/{chapterId}": {
      "get": {
        "tags": ["投稿审核"], "summary": "预览投稿章节正文", "security": [{ "AdminToken": [] }],
        "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/ChapterId" }],
        "responses": { "200": { "description": "成功", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Envelope" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/PreviewChapter" } } }] } } } } }
      }
    },
    "/admin/submissions/{id}/approve": {
      "post": {
        "tags": ["投稿审核"], "summary": "批准投稿并复制为公开作品", "description": "可选覆盖书名、作者、分类、简介。审核状态必须为 PENDING。", "security": [{ "AdminToken": [] }],
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Decision" } } } },
        "responses": { "200": { "description": "成功，data 为公开书籍 ID", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Envelope" }, { "type": "object", "properties": { "data": { "type": "integer", "format": "int64" } } }] } } } } }
      }
    },
    "/admin/submissions/{id}/reject": {
      "post": {
        "tags": ["投稿审核"], "summary": "退稿", "security": [{ "AdminToken": [] }],
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reason" } } } },
        "responses": { "200": { "$ref": "#/components/responses/EmptyResult" } }
      }
    },
    "/admin/withdrawals": {
      "get": {
        "tags": ["撤回审核"], "summary": "分页查询撤回申请", "security": [{ "AdminToken": [] }],
        "parameters": [{ "name": "status", "in": "query", "schema": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED", "CLOSED"] } }, { "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/Size" }],
        "responses": { "200": { "$ref": "#/components/responses/WithdrawalPage" } }
      }
    },
    "/admin/withdrawals/{id}/approve": {
      "post": {
        "tags": ["撤回审核"], "summary": "批准撤回并下架", "security": [{ "AdminToken": [] }],
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": { "200": { "$ref": "#/components/responses/EmptyResult" } }
      }
    },
    "/admin/withdrawals/{id}/reject": {
      "post": {
        "tags": ["撤回审核"], "summary": "驳回撤回申请", "security": [{ "AdminToken": [] }],
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reason" } } } },
        "responses": { "200": { "$ref": "#/components/responses/EmptyResult" } }
      }
    },
    "/admin/publications/{bookId}/take-down": {
      "post": {
        "tags": ["公开作品管理"], "summary": "管理员主动下架", "description": "未处理的撤回申请变为 CLOSED；私人原件不变。", "security": [{ "AdminToken": [] }],
        "parameters": [{ "$ref": "#/components/parameters/BookId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reason" } } } },
        "responses": { "200": { "$ref": "#/components/responses/EmptyResult" } }
      }
    },
    "/admin/audit-logs": {
      "get": {
        "tags": ["审核日志"], "summary": "分页查询操作日志", "security": [{ "AdminToken": [] }],
        "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/Size" }],
        "responses": { "200": { "$ref": "#/components/responses/AuditPage" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "UserToken": { "type": "apiKey", "in": "header", "name": "Authorization", "description": "普通用户 JWT" },
      "AdminToken": { "type": "apiKey", "in": "header", "name": "Authorization", "description": "管理员 JWT" }
    },
    "parameters": {
      "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } },
      "NovelId": { "name": "novelId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } },
      "BookId": { "name": "bookId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } },
      "ChapterId": { "name": "chapterId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } },
      "Page": { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1, "minimum": 1 } },
      "Size": { "name": "size", "in": "query", "schema": { "type": "integer", "default": 20, "minimum": 1, "maximum": 100 } }
    },
    "schemas": {
      "Envelope": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string", "example": "00000" }, "data": {}, "message": { "type": "string", "example": "成功" } } },
      "ImportForm": { "type": "object", "required": ["file"], "properties": { "file": { "type": "string", "format": "binary", "description": "不超过 20 MB 的 TXT" }, "visibility": { "type": "string", "enum": ["PRIVATE", "PUBLIC"], "default": "PRIVATE" }, "bookName": { "type": "string", "maxLength": 128 }, "authorName": { "type": "string", "maxLength": 64 }, "categoryId": { "type": "integer", "format": "int64" }, "bookDesc": { "type": "string", "maxLength": 2000 }, "rightsConfirmed": { "type": "boolean" } } },
      "ResubmitForm": { "type": "object", "required": ["bookName", "authorName", "categoryId", "rightsConfirmed"], "properties": { "bookName": { "type": "string", "maxLength": 128 }, "authorName": { "type": "string", "maxLength": 64 }, "categoryId": { "type": "integer", "format": "int64" }, "bookDesc": { "type": "string", "maxLength": 2000 }, "rightsConfirmed": { "type": "boolean", "enum": [true] }, "file": { "type": "string", "format": "binary", "description": "可选的新 TXT，提供后重置私人阅读进度" } } },
      "PrivateNovel": { "type": "object", "properties": { "id": { "type": "integer", "format": "int64", "nullable": true }, "bookName": { "type": "string" }, "authorName": { "type": "string", "nullable": true }, "categoryId": { "type": "integer", "format": "int64", "nullable": true }, "bookDesc": { "type": "string", "nullable": true }, "rightsConfirmed": { "type": "boolean", "nullable": true }, "chapterCount": { "type": "integer" }, "wordCount": { "type": "integer", "format": "int64" }, "visibility": { "type": "string" }, "submissionId": { "type": "integer", "format": "int64", "nullable": true }, "submissionStatus": { "type": "string", "nullable": true }, "rejectionReason": { "type": "string", "nullable": true }, "publicBookId": { "type": "integer", "format": "int64", "nullable": true }, "publicStatus": { "type": "string", "nullable": true } } },
      "Submission": { "type": "object", "properties": { "id": { "type": "integer", "format": "int64" }, "userNovelId": { "type": "integer", "format": "int64", "nullable": true }, "userId": { "type": "integer", "format": "int64" }, "username": { "type": "string" }, "originalFileName": { "type": "string", "nullable": true }, "bookName": { "type": "string" }, "authorName": { "type": "string" }, "categoryId": { "type": "integer", "format": "int64" }, "categoryName": { "type": "string" }, "bookDesc": { "type": "string", "nullable": true }, "rightsConfirmed": { "type": "boolean" }, "status": { "type": "string", "enum": ["PENDING", "REJECTED", "APPROVED", "CANCELLED"] }, "publicStatus": { "type": "string", "nullable": true }, "rejectionReason": { "type": "string", "nullable": true }, "publicBookId": { "type": "integer", "format": "int64", "nullable": true }, "chapterCount": { "type": "integer", "nullable": true }, "wordCount": { "type": "integer", "format": "int64", "nullable": true }, "submittedAt": { "type": "string", "format": "date-time" }, "reviewedAt": { "type": "string", "format": "date-time", "nullable": true } } },
      "PreviewChapter": { "type": "object", "properties": { "id": { "type": "integer", "format": "int64" }, "novelId": { "type": "integer", "format": "int64" }, "chapterNum": { "type": "integer" }, "chapterName": { "type": "string" }, "wordCount": { "type": "integer" }, "content": { "type": "string", "description": "仅正文预览接口返回" } } },
      "Withdrawal": { "type": "object", "properties": { "id": { "type": "integer", "format": "int64" }, "userNovelId": { "type": "integer", "format": "int64", "nullable": true }, "publicBookId": { "type": "integer", "format": "int64" }, "userId": { "type": "integer", "format": "int64" }, "username": { "type": "string" }, "bookName": { "type": "string" }, "reason": { "type": "string", "nullable": true }, "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED", "CLOSED"] }, "createTime": { "type": "string", "format": "date-time" }, "reviewedAt": { "type": "string", "format": "date-time", "nullable": true } } },
      "AuditLog": { "type": "object", "properties": { "id": { "type": "integer", "format": "int64" }, "adminId": { "type": "integer", "format": "int64" }, "adminUsername": { "type": "string" }, "targetType": { "type": "string" }, "targetId": { "type": "integer", "format": "int64" }, "action": { "type": "string" }, "reason": { "type": "string", "nullable": true }, "createTime": { "type": "string", "format": "date-time" } } },
      "Decision": { "type": "object", "properties": { "bookName": { "type": "string", "maxLength": 128 }, "authorName": { "type": "string", "maxLength": 64 }, "categoryId": { "type": "integer", "format": "int64" }, "bookDesc": { "type": "string", "maxLength": 2000 } } },
      "Reason": { "type": "object", "required": ["reason"], "properties": { "reason": { "type": "string", "minLength": 1, "maxLength": 500 } } }
    },
    "responses": {
      "EmptyResult": { "description": "成功，data 为 null", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
      "PrivateNovelResult": { "description": "成功", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Envelope" }, { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/PrivateNovel" } } }] } } } },
      "SubmissionPage": { "description": "成功", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Envelope" }, { "type": "object", "properties": { "data": { "type": "object", "properties": { "list": { "type": "array", "items": { "$ref": "#/components/schemas/Submission" } }, "page": { "type": "integer" }, "size": { "type": "integer" }, "total": { "type": "integer", "format": "int64" } } } } }] } } } },
      "WithdrawalPage": { "description": "成功", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Envelope" }, { "type": "object", "properties": { "data": { "type": "object", "properties": { "list": { "type": "array", "items": { "$ref": "#/components/schemas/Withdrawal" } }, "page": { "type": "integer" }, "size": { "type": "integer" }, "total": { "type": "integer", "format": "int64" } } } } }] } } } },
      "AuditPage": { "description": "成功", "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Envelope" }, { "type": "object", "properties": { "data": { "type": "object", "properties": { "list": { "type": "array", "items": { "$ref": "#/components/schemas/AuditLog" } }, "page": { "type": "integer" }, "size": { "type": "integer" }, "total": { "type": "integer", "format": "int64" } } } } }] } } } }
    }
  }
}
